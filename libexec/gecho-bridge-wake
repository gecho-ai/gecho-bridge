#!/bin/sh
# Installed root-owned by `gecho-bridge wake enable`.
# It deliberately accepts only Gecho's own one-time wake events.
set -eu

PMSET="/usr/bin/pmset"
OWNER="com.gecho-ai.gecho-bridge"

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
  echo "gecho-bridge-wake must run as root" >&2
  exit 1
fi

usage() {
  echo "usage: gecho-bridge-wake {schedule|cancel} 'MM/dd/yy HH:mm:ss' | status" >&2
  exit 64
}

validate_date() {
  case "$1" in
    [0-1][0-9]/[0-3][0-9]/[0-9][0-9]\ [0-2][0-9]:[0-5][0-9]:[0-5][0-9]) ;;
    *) echo "invalid wake date" >&2; exit 64 ;;
  esac
}

case "${1:-}" in
  schedule)
    [ "$#" -eq 2 ] || usage
    validate_date "$2"
    exec "$PMSET" schedule wake "$2" "$OWNER"
    ;;
  cancel)
    [ "$#" -eq 2 ] || usage
    validate_date "$2"
    exec "$PMSET" schedule cancel wake "$2" "$OWNER"
    ;;
  status)
    [ "$#" -eq 1 ] || usage
    exec "$PMSET" -g sched
    ;;
  *) usage ;;
esac
