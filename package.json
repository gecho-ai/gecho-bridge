{
  "name": "@gecho-ai/gecho-bridge",
  "version": "1.1.38",
  "description": "Browser research tools for OpenClaw, connecting LLMs to TikTok, YouTube Shorts, Facebook Reels, X, and Amazon via the Gecho Chrome Extension.",
  "main": "mcp-client.js",
  "bin": {
    "gecho-bridge": "mcp-client.js",
    "gecho-bridge-server": "bridge-service.js"
  },
  "files": [
    "*.js",
    "dist",
    "package.json",
    ".claude-plugin",
    ".mcp.json",
    "openclaw.plugin.json",
    "skills",
    "distribution-skills",
    "distribution-skills-zh-CN",
    "README.md",
    "README.zh.md",
    "qywx.jpg"
  ],
  "scripts": {
    "start": "node mcp-client.js",
    "server": "node server.js",
    "server:start": "node bridge-service.js start",
    "server:status": "node bridge-service.js status",
    "server:stop": "node bridge-service.js stop",
    "server:restart": "node bridge-service.js restart",
    "desktop:build-native": "node desktop/build-macos-tray.js",
    "desktop:dev": "npm run desktop:build-native && electron desktop/main.js",
    "desktop:pack": "npm run desktop:build-native && electron-builder --dir",
    "desktop:dist": "npm run desktop:build-native && electron-builder",
    "desktop:dist:win": "npm run desktop:build-native && electron-builder --win nsis --x64 --publish never",
    "desktop:pack:win": "npm run desktop:build-native && electron-builder --win --x64 --dir --publish never",
    "setup": "openclaw plugins install -l .",
    "sync:version": "node ./scripts/sync-version.js",
    "build:bundle": "node ./scripts/build-bundle.js",
    "bundle:stage": "bash ./scripts/publish-bundle-dist.sh stage",
    "bundle:publish": "bash ./scripts/publish-bundle-dist.sh publish",
    "bundle:stage:dist": "bash ./scripts/publish-bundle-dist.sh stage",
    "bundle:publish:dist": "bash ./scripts/publish-bundle-dist.sh publish",
    "skill:validate": "node ./scripts/validate-skills.js",
    "skill:package:manual": "bash ./scripts/package-manual-skills.sh",
    "skill:stage": "bash ./scripts/publish-clawhub-skills.sh stage",
    "skill:dry-run": "bash ./scripts/publish-clawhub-skills.sh dry-run",
    "skill:publish": "bash ./scripts/publish-clawhub-skills.sh publish",
    "skill:legacy:stage": "bash ./scripts/publish-skills.sh stage",
    "skill:legacy:dry-run": "bash ./scripts/publish-skills.sh dry-run",
    "skill:legacy:publish": "bash ./scripts/publish-skills.sh publish",
    "skill:skills-sh:dry-run": "bash ./scripts/publish-skills-sh.sh dry-run",
    "skill:skills-sh:publish": "bash ./scripts/publish-skills-sh.sh publish",
    "skillhub:tencent:stage": "bash ./scripts/publish-tencent-skillhub.sh stage",
    "skillhub:tencent:dry-run": "bash ./scripts/publish-tencent-skillhub.sh dry-run",
    "skillhub:tencent:publish": "bash ./scripts/publish-tencent-skillhub.sh publish",
    "skillhub:aily:dry-run": "bash ./scripts/publish-aily-browser.sh dry-run",
    "skillhub:aily:publish": "bash ./scripts/publish-aily-browser.sh publish",
    "skillhub:workbuddy:stage": "node ./scripts/publish-workbuddy-skills.js stage",
    "skillhub:workbuddy:package": "node ./scripts/publish-workbuddy-skills.js package",
    "skillhub:workbuddy:dry-run": "node ./scripts/publish-workbuddy-skills.js dry-run",
    "skillhub:workbuddy:connector": "node ./scripts/package-workbuddy-connector.js",
    "skillhub:workbuddy:connector:dry-run": "node ./scripts/package-workbuddy-connector.js dry-run",
    "skillhub:modelscope:stage": "bash ./scripts/publish-modelscope-skills.sh stage",
    "skillhub:modelscope:dry-run": "bash ./scripts/publish-modelscope-skills.sh dry-run",
    "skillhub:modelscope:publish": "bash ./scripts/publish-modelscope-skills.sh publish",
    "skillhub:modelscope:verify": "bash ./scripts/publish-modelscope-skills.sh verify",
    "publish:config:generate": "node ./scripts/generate-publish-configs.js",
    "publish:config:check": "node ./scripts/generate-publish-configs.js --check",
    "test:skillhub:tencent": "node --test ./test/publish-config.test.js ./test/tencent-skillhub-publish.test.js",
    "test:workbuddy": "node --test ./test/publish-config.test.js ./test/workbuddy-publish.test.js",
    "test:skillhub:modelscope": "node --test ./test/modelscope-publish.test.js"
  },
  "keywords": [
    "mcp",
    "tiktok",
    "bridge",
    "automation",
    "llm",
    "gecho"
  ],
  "author": "Gecho AI",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.4",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "ai.gecho.desktop",
    "productName": "Gecho",
    "artifactName": "Gecho-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "data-dir.js",
      "action-result.js",
      "scheduled-task-store.js",
      "scheduled-task-scheduler.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "asarUnpack": [
      "desktop/macos-tray/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": { "LSUIElement": true }
    },
    "win": {
      "executableName": "Gecho",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gecho",
      "uninstallDisplayName": "Gecho",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "desktop/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
